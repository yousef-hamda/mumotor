{
  "name": "@mumotor/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test": "node test/integration.mjs",
    "test:security": "node test/security.integration.mjs",
    "test:ratelimit": "node test/ratelimit.unit.mjs",
    "test:cron": "tsx test/cron-check.ts",
    "test:billing": "tsx test/billing.check.ts",
    "test:trial": "tsx test/trial-freeze.check.ts",
    "test:pubsite": "tsx test/public-site-render.check.ts",
    "test:google": "tsx test/google-auth.check.ts",
    "test:notify": "tsx test/notifications.check.ts",
    "test:time": "tsx test/time.unit.ts",
    "check:env": "tsx test/env-example.check.ts",
    "test:unsub": "tsx test/unsubscribe.check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1088.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.3",
    "prisma": "^5.22.0",
    "stripe": "^22.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
