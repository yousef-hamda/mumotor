# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://otto:otto@localhost:5432/otto_driving"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
NODE_ENV=development
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"

# --- Redis (optional; in-memory fallback if unset) ---
REDIS_URL="redis://localhost:6379"

# --- Email / SMTP (optional; console transport if unset) ---
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user"
# SMTP_PASS="pass"
# SMTP_SECURE=false
EMAIL_FROM="DriveSawa <no-reply@otto.local>"

# --- Cron jobs ---
ENABLE_CRON=true
