# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://otto:otto@localhost:5432/otto_driving"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
NODE_ENV=development
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"
# All "today/tomorrow" logic uses this wall-clock zone (defaults to Asia/Jerusalem).
# APP_TIMEZONE="Asia/Jerusalem"

# --- Redis (optional; in-memory fallback if unset — required in multi-instance prod) ---
REDIS_URL="redis://localhost:6379"

# --- Email (transport priority: Amazon SES → Resend → SMTP → console) ---
# SES_ENABLED=true
# SES_REGION="eu-north-1"
# SES_ACCESS_KEY_ID="..."
# SES_SECRET_ACCESS_KEY="..."
# RESEND_API_KEY="re_..."
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user"
# SMTP_PASS="pass"
# SMTP_SECURE=false
EMAIL_FROM="Mumotor <no-reply@mumotor.local>"

# --- Billing (Stripe; dormant until keys + price ids are set) ---
# STRIPE_SECRET_KEY="sk_..."
# STRIPE_PUBLISHABLE_KEY="pk_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_STUDIO="price_..."
# Per-extra-website subscription price id (₪199/mo seat).
# STRIPE_PRICE_WEBSITE="price_..."
# Days the first website is free, from signup (default 30).
# TRIAL_DAYS=30

# --- Integrations ---
# UNSPLASH_ACCESS_KEY="..."   # Customize photo picker ("Find" images)

# --- Cron jobs ---
ENABLE_CRON=true
