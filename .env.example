# ── DriveSawa — environment (copy to packages/backend/.env for local dev) ──

# Required
DATABASE_URL="postgresql://otto:otto@localhost:5432/otto_driving"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars-in-prod"

# Server
PORT=4000                      # Railway assigns this dynamically in prod
NODE_ENV=development           # use "staging" on Railway (relaxed validation)
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"

# Redis (optional locally — in-memory fallback if unset)
REDIS_URL="redis://localhost:6379"

# Email / SMTP (optional — console transport if unset; Resend recommended in prod)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
EMAIL_FROM="DriveSawa <no-reply@drivesawa.com>"

# Cron jobs
ENABLE_CRON=true

# Localization
BUSINESS_TIMEZONE="Asia/Jerusalem"
DEFAULT_LOCALE="he"

# ── Optional integrations (the app runs without these) ──
# AI providers (generation is deterministic; these only power optional bio enhancement)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Stripe (billing runs in demo mode without these)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Pexels (generated sites use static Pexels CDN URLs without a key)
# PEXELS_API_KEY=

# S3 / R2 storage (media uploads — optional)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# ── Frontend (packages/frontend/.env.production for Vercel) ──
# VITE_API_URL=https://<your-backend>.up.railway.app/api
# VITE_SITE_BASE=https://<your-backend>.up.railway.app
