# Mumotor — environment configuration.
#
# GENERATED FROM packages/backend/src/config/env.ts — that schema is the source of truth.
# Every key it validates appears below. Both example files had drifted 21 keys behind it,
# so a fresh setup silently ran with no email, no Google sign-in and the wrong timezone.
# `npm run check:env` fails if they diverge again.

# ── Core ──
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://otto:otto@localhost:5432/otto_driving   # required
JWT_SECRET=   # REQUIRED in production, min 32 chars — generate with: openssl rand -hex 32
JWT_EXPIRES_IN=7d
APP_TIMEZONE=Asia/Jerusalem   # wall-clock zone for every today/tomorrow calculation — WRONG VALUE = WRONG BOOKING DAYS

# ── Public URLs ──
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ── Cache / rate-limit store (optional, but see below) ──
REDIS_URL=   # without it, rate limits are per-process and reset on every deploy

# ── Email — transport priority: SES -> Resend -> SMTP -> console ──
EMAIL_FROM=Mumotor Driving School <no-reply@mumotor.local>
SES_ENABLED=false   # explicit on-switch; SES only takes over when true AND the SES_* creds are set
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── Billing (Stripe). NOTE: with no price id set, the trial-expiry job deliberately does NOT freeze accounts. ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_WEBSITE=
TRIAL_DAYS=30   # days the first website is free from signup (default 30)

# ── Sign in with Google (whole feature is dormant until set) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Photo search in Customize ──
UNSPLASH_ACCESS_KEY=

# ── Background jobs ──
ENABLE_CRON=true   # set false for tests
